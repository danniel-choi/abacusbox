{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "calcrule-blog-scheduler",
  "main": "index.js",
  "compatibility_date": "2026-08-24",
  "triggers": {
    "crons": ["5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "calcrule",
      "database_name": "calcrule-prod",
      "database_id": "59326fbf-7206-4a36-903d-1649a49d4308"
    }
  ]
}
